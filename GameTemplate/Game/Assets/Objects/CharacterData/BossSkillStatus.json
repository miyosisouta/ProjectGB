            "cooldown": 0.0,
            "vibrationTime": 0.0,
            "vibrationForce": 0.0,
            "correspondingState": "対応するプログラム側のステートクラス名をここに書く（例: BossAttackState）",
            "stateId": "対応するBossStateIDをここに書く（例: Attack）"
        }
    ],

